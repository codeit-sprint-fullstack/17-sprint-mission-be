generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  price       Int
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Article {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 상품 또는 게시글 중 하나에 연결 (onDelete: Cascade로 부모 삭제 시 댓글도 함께 정리)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  articleId Int?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([articleId])
}